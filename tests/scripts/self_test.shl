#! /home/callum/projects/shl/build/shl

/#
Use a shl script to test shl, marking its own homework.
Path for test files is in argv[0]:
#/

path := home()+"/projects/shl/tests/scripts";
shl := home()+"/projects/shl/build/shl";
tmp_root := home()+"/projects/shl/build/tmp";

# meson sets a tmp path when calling
if (env_exists("SHL_TEST_TMP")) {
    tmp_root = env("SHL_TEST_TMP");
}

println("Using tmp root: ", tmp_root);

sequence();
environment();
filesystem_create();
filesystem_rmv();


fn sequence ()
{
    script := path + "/sequence.shl";

    pipeline := proc(shl, script);
    result := to_int(exec_stdout(exec(pipeline)));

    check_int(19, result);
}

fn environment ()
{
    script := path + "/env.shl";
    pipeline := proc(shl, script);
    result := exec_stdout(exec(pipeline));

    check_str("hello world", result);
}

fn filesystem_create ()
{
    tmp_dir := tmp_root + "/fs_create";

    # rm the temp dir via `rm` just in case it exists (ignore error if it doesn't).
    # it's incorrect to delete via shl because we need to test it
    rmv_result := exec(proc("rm", "-rf", tmp_dir));
    check_bool(true, exec_success(rmv_result));

    # create tmp_dir
    check_bool(false, path_exists(tmp_dir));
    check_bool(true, dir_create(tmp_dir));
    check_bool(true, path_exists(tmp_dir));

    # when root required
    invalid_file := "/etc/anything_not_root";
    invalid_dir := "/etc/anything_not_root";

    check_bool(false, file_create(invalid_file));
    check_int(13, error_code());
    check_str("Permission denied", error_message());

    check_bool(false, file_create(invalid_dir));
    check_int(13, error_code());
    check_str("Permission denied", error_message());

    exec(proc("rm", "-rf", tmp_root));
}

fn filesystem_rmv ()
{
    wd := tmp_root + "/fs_rmv";

    rmv_result := exec(proc("rm", "-rf", wd));
    check_bool(true, exec_success(rmv_result));

    check_bool(true, dir_create(wd));

    # delete a file
    check_bool(true, file_create(wd+"/foo.txt"));
    check_bool(true, path_exists(wd+"/foo.txt"));
    check_bool(true, path_rmv(wd+"/foo.txt"));
    check_bool(false, path_exists(wd+"/foo.txt"));

    # delete an empty dir with path_rmv()
    check_bool(true, dir_create(wd+"/foo"));
    check_bool(true, path_exists(wd+"/foo"));
    check_bool(true, path_rmv(wd+"/foo"));
    check_bool(false, path_exists(wd+"/foo"));

    # delete a dir containing a file (file_create() creates intermediate dirs)
    check_bool(true, file_create(wd+"/foo/foo.txt"));
    check_bool(true, path_rmv_dir(wd+"/foo"));
    check_bool(false, path_exists(wd+"/foo"));
}


# don't support overloading, templates or variants so need this abomination

fn check_bool(expected: bool, result: bool)
{
    if (expected == result) {
        println ("PASS: ", result);
    }
    else {
        println ("FAIL: ", result);
        exit(1);
    }
}

fn check_int(expected: int, result: int)
{
    if (expected == result) {
        println ("PASS: ", result);
    }
    else {
        println ("FAIL: ", result);
        exit(1);
    }
}

fn check_str(expected: str, result: str)
{
    if (expected == result) {
        println ("PASS: ", result);
    }
    else {
        println ("FAIL: ", result);
        exit(1);
    }
}
